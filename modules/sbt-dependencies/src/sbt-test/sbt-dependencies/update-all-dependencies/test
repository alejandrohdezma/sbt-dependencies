# Run the full update flow (http4s-core 0.21.0 -> 0.21.34, sbt 1.10.0 -> 1.10.11)
> updateAllDependencies

# Verify snapshots were cleaned up
-$ exists target/sbt-dependencies/.sbt-dependency-snapshot
-$ exists target/sbt-dependencies/.sbt-build-snapshot
-$ exists target/sbt-dependencies/.sbt-plugin-snapshot
-$ exists target/sbt-dependencies/.sbt-version-snapshot

# Validate the diff file matches expected output (covers compile + test configurations from
# the munit:test dep added to dependencies.conf for scope coverage)
$ must-mirror target/sbt-dependencies/.sbt-dependency-diff expected-diff

# Scalafix migrations default to pre-update (Scala Steward's default) and land in their own file;
# post-update hooks keep the hooks file
$ must-mirror target/sbt-dependencies/.sbt-pre-update-migrations expected-migrations
$ must-mirror target/sbt-dependencies/.sbt-post-update-hooks expected-scripts
