{
  "name": "sbt-dependencies",
  "displayName": "sbt-dependencies",
  "description": "Syntax highlighting for sbt-dependencies configuration files",
  "version": "0.20.0",
  "publisher": "alejandrohdezma",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/alejandrohdezma/sbt-dependencies"
  },
  "engines": {
    "vscode": "^1.82.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:sbt-dependencies",
    "workspaceContains:**/*.sbt"
  ],
  "icon": "icon.png",
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "sbt-dependencies",
        "filenames": [
          "dependencies.conf"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "sbt-dependencies",
        "scopeName": "source.sbt-dependencies",
        "path": "./syntaxes/dependencies.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "sbt-dependencies.updateAllDependencies",
        "title": "Update All Dependencies",
        "category": "SBT Dependencies",
        "enablement": "resourceLangId == sbt-dependencies"
      },
      {
        "command": "sbt-dependencies.updateDependencies",
        "title": "Update Dependencies",
        "category": "SBT Dependencies",
        "enablement": "resourceLangId == sbt-dependencies"
      },
      {
        "command": "sbt-dependencies.installDependency",
        "title": "Install Dependency",
        "category": "SBT Dependencies",
        "enablement": "resourceLangId == sbt-dependencies"
      },
      {
        "command": "sbt-dependencies.openDependenciesGroup",
        "title": "View Dependencies Group",
        "category": "SBT Dependencies"
      },
      {
        "command": "sbt-dependencies.openBuildProject",
        "title": "View Project Definition",
        "category": "SBT Dependencies"
      },
      {
        "command": "sbt-dependencies.importBuild",
        "title": "Import sbt Build via Metals",
        "category": "SBT Dependencies"
      }
    ],
    "configurationDefaults": {
      "files.associations": {
        "dependencies.conf": "sbt-dependencies"
      },
      "[sbt-dependencies]": {
        "editor.fontLigatures": false,
        "editor.formatOnPaste": true
      }
    },
    "configuration": {
      "title": "SBT Dependencies",
      "properties": {
        "sbt-dependencies.buildImportPrompt": {
          "type": "boolean",
          "default": true,
          "description": "Show a notification offering to import the sbt build through Metals when dependencies.conf changes after the last import. The status bar indicator is always shown."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc --noEmit",
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "prepackage": "npm run build -- --production",
    "package": "vsce package",
    "publish": "vsce publish",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/vscode": "^1.82.0",
    "@types/node": "^26.2.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "vscode-tmgrammar-test": "^0.1.3"
  }
}
