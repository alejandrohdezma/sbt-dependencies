<idea-plugin>
  <id>com.alejandrohdezma.sbt-dependencies</id>
  <name>sbt-dependencies</name>
  <version>0.0.0</version>
  <idea-version since-build="251"/>
  <vendor url="https://github.com/alejandrohdezma">alejandrohdezma</vendor>
  <description><![CDATA[
    Language support for <code>dependencies.conf</code> files used by the
    <a href="https://github.com/alejandrohdezma/sbt-dependencies">sbt-dependencies</a> sbt plugin:
    <ul>
      <li><b>Syntax highlighting</b> for every part of a dependency, customizable under the color scheme settings.</li>
      <li><b>Diagnostics</b> matching the exact errors the sbt plugin itself would fail with, with quick fixes for removable entries.</li>
      <li><b>Hovers</b> explaining version markers, with resolved versions, BOM provenance and mvnrepository links.</li>
      <li><b>Resolved versions</b> shown inline for <code>*</code> and <code>{{variable}}</code> dependencies, read from the sbt plugin's own resolution dump.</li>
      <li><b>Notes</b> folded into <code>// comments</code> next to their dependency, with an "Add note" intention for pinned or intransitive entries.</li>
      <li><b>Paste conversion</b> turning SBT-style dependencies (<code>libraryDependencies +=</code>, <code>addSbtPlugin(...)</code>) into canonical strings.</li>
      <li><b>Navigation</b> between group names and their <code>build.sbt</code> project definitions, usage highlighting and variable rename.</li>
      <li><b>Source links</b> opening a dependency's source repository on Cmd+Click, read from the POMs in the local
      Coursier cache, with mvnrepository.com as fallback.</li>
      <li><b>Structure view</b> with groups and their dependencies as navigable children.</li>
      <li><b>Formatting</b> producing the exact output of the <code>dependenciesFormat</code> sbt task — groups and dependencies sorted, canonical indentation, comments dropped.</li>
      <li><b>sbt tasks</b> (install/update dependencies) runnable from the Tools menu.</li>
      <li><b>Reload prompts</b> showing IntelliJ's floating "reload project" widget when <code>dependencies.conf</code>
      changes, the same one the sbt integration shows for <code>build.sbt</code> (requires the Scala plugin).</li>
    </ul>
  ]]></description>
  <change-notes><![CDATA[
    <ul>
      <li>Cmd+Click on a dependency now opens its source repository (usually GitHub), read from the POMs in the local
      Coursier cache, falling back to mvnrepository.com.</li>
    </ul>
  ]]></change-notes>

  <depends>com.intellij.modules.platform</depends>

  <extensions defaultExtensionNs="com.intellij">
    <fileType 
      id="sbt-dependencies"
      name="sbt-dependencies" 
      language="sbt-dependencies" 
      fileNames="dependencies.conf"
      implementationClass="com.alejandrohdezma.sbt.dependencies.intellij.lang.SbtDependenciesFileType"
    />
    <lang.parserDefinition
      language="sbt-dependencies"
      implementationClass="com.alejandrohdezma.sbt.dependencies.intellij.lang.SbtDependenciesParserDefinition"
    />
    <lang.syntaxHighlighterFactory
      language="sbt-dependencies"
      implementationClass="com.alejandrohdezma.sbt.dependencies.intellij.highlight.SbtDependenciesSyntaxHighlighterFactory"
    />
    <externalAnnotator
      language="sbt-dependencies"
      implementationClass="com.alejandrohdezma.sbt.dependencies.intellij.diagnostics.SbtDependenciesAnnotator"
    />
    <additionalTextAttributes
      scheme="Default"
      file="colorSchemes/SbtDependenciesDefault.xml"
    />
    <additionalTextAttributes
      scheme="Darcula"
      file="colorSchemes/SbtDependenciesDarcula.xml"
    />
    <colorSettingsPage
      implementation="com.alejandrohdezma.sbt.dependencies.intellij.highlight.SbtDependenciesColorSettingsPage"
    />
    <lang.documentationProvider
      language="sbt-dependencies"
      implementationClass="com.alejandrohdezma.sbt.dependencies.intellij.documentation.SbtDependenciesDocumentationProvider"
    />
    <lang.commenter
      language="sbt-dependencies"
      implementationClass="com.alejandrohdezma.sbt.dependencies.intellij.editor.SbtDependenciesCommenter"
    />
    <lang.braceMatcher
      language="sbt-dependencies"
      implementationClass="com.alejandrohdezma.sbt.dependencies.intellij.editor.SbtDependenciesBraceMatcher"
    />
    <lang.foldingBuilder
      language="sbt-dependencies"
      implementationClass="com.alejandrohdezma.sbt.dependencies.intellij.editor.SbtDependenciesFoldingBuilder"
    />
    <editorFactoryListener
      implementation="com.alejandrohdezma.sbt.dependencies.intellij.editor.SbtDependenciesFoldingCaretListener"
    />
    <editorFactoryListener
      implementation="com.alejandrohdezma.sbt.dependencies.intellij.resolutions.SbtDependenciesResolvedVersionInlays"
    />
    <copyPastePreProcessor
      implementation="com.alejandrohdezma.sbt.dependencies.intellij.editor.SbtDependenciesPasteProcessor"
    />
    <lang.psiStructureViewFactory
      language="sbt-dependencies"
      implementationClass="com.alejandrohdezma.sbt.dependencies.intellij.structure.SbtDependenciesOutlineViewFactory"
    />
    <highlightUsagesHandlerFactory
      implementation="com.alejandrohdezma.sbt.dependencies.intellij.navigation.SbtDependenciesUsagesHandlerFactory"
    />
    <gotoDeclarationHandler
      implementation="com.alejandrohdezma.sbt.dependencies.intellij.navigation.SbtDependenciesGotoDeclarationHandler"
    />
    <formattingService
      implementation="com.alejandrohdezma.sbt.dependencies.intellij.formatting.SbtDependenciesFormattingService"
    />
    <notificationGroup
      id="sbt-dependencies"
      displayType="BALLOON"
    />
    <postStartupActivity
      implementation="com.alejandrohdezma.sbt.dependencies.intellij.externalsystem.SbtDependenciesProjectAwareStarter"
    />
  </extensions>

  <actions>
    <group
      id="sbt-dependencies"
      text="sbt-dependencies"
      popup="true"
    >
      <add-to-group
        group-id="ToolsMenu"
        anchor="last"
      />
      <action
        id="sbt-dependencies.updateAllDependencies"
        class="com.alejandrohdezma.sbt.dependencies.intellij.actions.UpdateAllDependenciesAction"
        text="Update All Dependencies"
        description="Runs sbtn updateAllDependencies at the build root"
      />
      <action
        id="sbt-dependencies.updateDependencies"
        class="com.alejandrohdezma.sbt.dependencies.intellij.actions.UpdateDependenciesAction"
        text="Update Dependencies"
        description="Runs sbtn updateDependencies at the build root"
      />
      <action
        id="sbt-dependencies.installDependency"
        class="com.alejandrohdezma.sbt.dependencies.intellij.actions.InstallDependencyAction"
        text="Install Dependency..."
        description="Prompts for a group and dependency, then runs the matching sbtn install task"
      />
    </group>
  </actions>
</idea-plugin>
